load(
    "//rules:defs.bzl",
    "sv_library",
    "verilator_lint_test",
    "verilator_test",
    "vivado_bitstream",
    "vivado_impl",
    "vivado_synth",
    "vivado_timing_test",
    "vivado_utilization_test",
    "xdc_library",
    "xsim_test",
)

package(default_visibility = ["//visibility:public"])

sv_library(
    name = "rv32i_pkg_lib",
    srcs = ["rv32i_pkg.sv"],
)

sv_library(
    name = "rv32i_core_lib",
    srcs = ["rv32i_core.sv"],
    deps = [":rv32i_pkg_lib"],
)

sv_library(
    name = "soc_memory_lib",
    srcs = ["soc_memory.sv"],
)

sv_library(
    name = "uart_tx_lib",
    srcs = ["uart_tx.sv"],
)

sv_library(
    name = "gpio_controller_lib",
    srcs = ["gpio_controller.sv"],
)

sv_library(
    name = "riscv_soc_lib",
    srcs = ["riscv_soc_top.sv"],
    deps = [
        ":gpio_controller_lib",
        ":rv32i_core_lib",
        ":rv32i_pkg_lib",
        ":soc_memory_lib",
        ":uart_tx_lib",
    ],
)

sv_library(
    name = "soc_tb_lib",
    srcs = ["soc_tb.sv"],
    data = ["firmware.mem"],
    deps = [":riscv_soc_lib"],
)

xdc_library(
    name = "riscv_soc_xdc",
    srcs = ["riscv_soc.xdc"],
    used_in = [
        "impl",
        "synth",
    ],
)

verilator_lint_test(
    name = "soc_lint_test",
    lint_flags = [
        "-Wno-IMPORTSTAR",
        "-Wno-UNUSEDSIGNAL",
    ],
    top = "riscv_soc_top",
    deps = [":riscv_soc_lib"],
)

verilator_test(
    name = "soc_verilator_test",
    data = ["firmware.mem"],
    top = "soc_tb",
    deps = [":soc_tb_lib"],
)

xsim_test(
    name = "soc_xsim_test",
    data = ["firmware.mem"],
    top = "soc_tb",
    deps = [":soc_tb_lib"],
)

vivado_synth(
    name = "soc_synth",
    board = "//boards/digilent/arty_a7_100:arty_a7_100",
    out_of_context = False,
    top = "riscv_soc_top",
    deps = [":riscv_soc_lib"],
    xdc = [":riscv_soc_xdc"],
)

vivado_impl(
    name = "soc_impl",
    board = "//boards/digilent/arty_a7_100:arty_a7_100",
    checkpoint = ":soc_synth",
    xdc = [":riscv_soc_xdc"],
)

vivado_timing_test(
    name = "soc_timing_test",
    checkpoint = ":soc_impl",
    min_wns = "0.0",
)

vivado_utilization_test(
    name = "soc_util_test",
    checkpoint = ":soc_impl",
    max_bram = 4,
    max_luts = 2500,
    max_registers = 1500,
)

vivado_bitstream(
    name = "soc_bitstream",
    bin_file = True,
    checkpoint = ":soc_impl",
    tcl_hooks = ["bitstream_pre.tcl"],
)
