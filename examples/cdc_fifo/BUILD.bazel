load(
    "//rules:defs.bzl",
    "sv_library",
    "verilator_lint_test",
    "verilator_test",
    "vivado_impl",
    "vivado_synth",
    "vivado_timing_test",
    "vivado_utilization_test",
    "xdc_library",
    "xsim_test",
)

package(default_visibility = ["//visibility:public"])

sv_library(
    name = "sync_2ff_lib",
    srcs = ["sync_2ff.sv"],
)

sv_library(
    name = "dual_port_bram_lib",
    srcs = ["dual_port_bram.sv"],
)

sv_library(
    name = "async_fifo_lib",
    srcs = ["async_fifo.sv"],
    deps = [
        ":dual_port_bram_lib",
        ":sync_2ff_lib",
    ],
)

sv_library(
    name = "cdc_fifo_tb_lib",
    srcs = ["cdc_fifo_tb.sv"],
    deps = [":async_fifo_lib"],
)

xdc_library(
    name = "cdc_fifo_xdc",
    srcs = ["cdc_fifo.xdc"],
    used_in = [
        "impl",
        "synth",
    ],
)

verilator_lint_test(
    name = "cdc_fifo_lint_test",
    top = "async_fifo",
    deps = [":async_fifo_lib"],
)

verilator_test(
    name = "cdc_fifo_verilator_test",
    top = "cdc_fifo_tb",
    deps = [":cdc_fifo_tb_lib"],
)

xsim_test(
    name = "cdc_fifo_xsim_test",
    top = "cdc_fifo_tb",
    deps = [":cdc_fifo_tb_lib"],
)

vivado_synth(
    name = "cdc_fifo_synth",
    out_of_context = True,
    part = "//parts:xc7a100tcsg324-1",
    top = "async_fifo",
    deps = [":async_fifo_lib"],
    xdc = [":cdc_fifo_xdc"],
)

vivado_impl(
    name = "cdc_fifo_impl",
    checkpoint = ":cdc_fifo_synth",
)

vivado_timing_test(
    name = "cdc_fifo_timing_test",
    checkpoint = ":cdc_fifo_impl",
    min_wns = "0.0",
)

vivado_utilization_test(
    name = "cdc_fifo_util_test",
    checkpoint = ":cdc_fifo_impl",
    max_bram = 2,
    max_luts = 250,
    max_registers = 250,
)
