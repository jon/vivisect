load("@rules_cc//cc:defs.bzl", "cc_test")
load(
    "//rules:defs.bzl",
    "sv_library",
    "verilator_library",
    "verilator_lint_test",
    "verilator_test",
    "xsim_test",
)

package(default_visibility = ["//visibility:public"])

# 1. Synthesizable Counter RTL
sv_library(
    name = "counter_rtl",
    srcs = ["rtl/counter.sv"],
)

# 2. Static Lint Check
verilator_lint_test(
    name = "counter_lint_test",
    top = "counter",
    deps = [":counter_rtl"],
)

# 3. Pure SystemVerilog Testbench (Dual-Simulator)
# The exact same SV testbench library is simulated under BOTH Verilator and AMD xsim.
sv_library(
    name = "counter_tb_lib",
    srcs = ["tb/counter_tb.sv"],
    deps = [":counter_rtl"],
)

# Run under modern Verilator (v5+ with --timing and auto-generated main)
verilator_test(
    name = "counter_verilator_test",
    top = "counter_tb",
    deps = [":counter_tb_lib"],
)

# Run under AMD xsim (4-state event-driven simulation)
xsim_test(
    name = "counter_xsim_test",
    top = "counter_tb",
    deps = [":counter_tb_lib"],
)

# 4. Decoupled C++ Model & Native C++ Testbench
# Compile RTL into a reusable C++ library exposing Vcounter class
verilator_library(
    name = "counter_cc_model",
    top = "counter",
    deps = [":counter_rtl"],
)

# Link C++ testbench against the Verilated C++ model
cc_test(
    name = "counter_cpp_test",
    srcs = ["tb/counter_tb.cpp"],
    deps = [
        ":counter_cc_model",
        "@verilator_default//:runtime",
    ],
)
