# General UX & Output formatting
common --color=yes
common --show_timestamps

# Test execution formatting
test --test_output=errors

# Propagate hardware licensing environment variables into Bazel actions
build --action_env=XILINXD_LICENSE_FILE
build --action_env=LM_LICENSE_FILE

# Sandbox configuration for host AMD FPGA tool installations
build --sandbox_add_mount_pair=/tools/Xilinx

# Execution profiles
# Local execution for EDA actions when sandbox filesystem mounts are bypassed
build:local_eda --spawn_strategy=local

# Strict sandboxed execution with explicit host tool mounting
build:sandboxed_eda --spawn_strategy=sandboxed --sandbox_add_mount_pair=/tools/Xilinx
