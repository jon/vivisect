load("@rules_python//python:defs.bzl", "py_test")
load(
    "//rules:defs.bzl",
    "verilator_lint_test",
    "verilator_test",
    "xsim_test",
)

package(default_visibility = ["//visibility:public"])

# Deliberate lint/syntax failure (manual tag so bazel test //... doesn't fail)
verilator_lint_test(
    name = "failing_lint_test",
    srcs = ["syntax_error.sv"],
    tags = ["manual"],
    top = "syntax_error",
)

# Deliberate xsim assertion failure
xsim_test(
    name = "failing_assertion_xsim",
    srcs = ["assertion_fail_tb.sv"],
    tags = ["manual"],
    top = "assertion_fail_tb",
)

# Deliberate verilator assertion failure
verilator_test(
    name = "failing_assertion_verilator",
    srcs = ["assertion_fail_tb.sv"],
    tags = ["manual"],
    top = "assertion_fail_tb",
)

# Automated negative trapping test verifying all deliberate failure modes are trapped
py_test(
    name = "negative_trapping_test",
    srcs = ["negative_trapping_test.py"],
    data = [
        ":failing_assertion_verilator",
        ":failing_assertion_xsim",
        ":failing_lint_test",
    ],
    tags = ["requires-network"],
)
