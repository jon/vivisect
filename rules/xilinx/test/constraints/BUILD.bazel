load(
    "//rules:defs.bzl",
    "sv_library",
    "vivado_impl",
    "vivado_synth",
    "vivado_timing_test",
    "vivado_utilization_test",
    "xdc_library",
)

package(default_visibility = ["//visibility:public"])

sv_library(
    name = "sub_cell_lib",
    srcs = ["sub_cell.sv"],
)

sv_library(
    name = "top_cell_lib",
    srcs = ["top_cell.sv"],
    deps = [":sub_cell_lib"],
)

xdc_library(
    name = "clock_xdc",
    srcs = ["clock.xdc"],
    used_in = [
        "impl",
        "synth",
    ],
)

xdc_library(
    name = "ref_scoped_xdc",
    srcs = ["ref_scoped.xdc"],
    scoped_to_ref = "sub_cell",
    used_in = [
        "impl",
        "synth",
    ],
)

xdc_library(
    name = "cell_scoped_xdc",
    srcs = ["cell_scoped.xdc"],
    scoped_to_cells = ["u_sub1"],
    used_in = [
        "impl",
        "synth",
    ],
)

vivado_synth(
    name = "top_synth",
    out_of_context = True,
    part = "//parts:xc7a100tcsg324-1",
    top = "top_cell",
    deps = [":top_cell_lib"],
    xdc = [
        ":clock_xdc",
        ":ref_scoped_xdc",
        ":cell_scoped_xdc",
    ],
)

vivado_impl(
    name = "top_impl",
    checkpoint = ":top_synth",
)

vivado_timing_test(
    name = "top_timing_test",
    checkpoint = ":top_impl",
    min_wns = "0.0",
)

vivado_utilization_test(
    name = "top_util_test",
    checkpoint = ":top_impl",
    max_luts = 20,
    max_registers = 20,
)
