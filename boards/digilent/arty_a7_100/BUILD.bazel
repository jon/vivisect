load("//rules/xilinx:vivado_board.bzl", "vivado_board")

package(default_visibility = ["//visibility:public"])

alias(
    name = "master_xdc",
    actual = "//vendor/digilent/arty_a7_100:arty_a7_100_master",
)

vivado_board(
    name = "arty_a7_100",
    board_part = "digilentinc.com:arty-a7-100:part0:1.1",
    constraints = [":master_xdc"],
    part = "//parts:xc7a100tcsg324-1",
)
